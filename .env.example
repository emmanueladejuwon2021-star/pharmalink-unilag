# ==============================================
# PharmaLink UNILAG Environment Configuration
# ==============================================

# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String
# e.g., mongodb://localhost:27017/pharmalink or mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/pharmalink_dev

# JWT Secret & Expiry (Authentication)
JWT_SECRET=replace_with_a_secure_jwt_secret_phrase_at_least_32_characters
JWT_EXPIRES_IN=7d

# File Storage (local / s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Admin Bootstrap Credentials (initial seed)
ADMIN_EMAIL=admin@pharmalink.unilag.edu.ng
